---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="404 — Page Not Found" description="Page not found" />
		<style>
			.code {
				margin-bottom: 0.5rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="code meta">404</p>
			<h1>Page not found</h1>
			<p>The page you're looking for doesn't exist. <a href="/">Back to the writing →</a></p>
		</main>
		<Footer />
	</body>
</html>
