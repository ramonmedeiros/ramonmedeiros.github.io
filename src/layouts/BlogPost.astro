---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, date, keywords } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} keywords={keywords as string[]} />
		<style>
			.title {
				margin-bottom: 2.5rem;
			}
			.title h1 {
				margin: 0.5rem 0 0;
			}
			.prose :global(h2) {
				margin-top: 2.5rem;
			}
			.prose :global(img) {
				display: block;
				margin: 1.5rem 0;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article class="prose">
				<header class="title">
					<FormattedDate date={date} class="meta" />
					<h1>{title}</h1>
				</header>
				<slot />
			</article>
		</main>
		<Footer />
	</body>
</html>
