---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="name" href="/">Ramon Medeiros</a>
		<div class="links">
			<HeaderLink href="/">Writing</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: var(--measure);
		margin: 0 auto;
		padding: 1.25rem;
		font-size: 0.95rem;
	}
	.name {
		color: var(--heading);
		font-weight: 600;
		text-decoration: none;
	}
	.links {
		display: flex;
		gap: 1.5rem;
	}
	@media (max-width: 640px) {
		nav {
			padding: 1rem;
		}
	}
</style>
