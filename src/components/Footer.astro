---
const today = new Date();
---

<footer>
	<div class="inner">
		<span>&copy; {today.getFullYear()} Ramon Medeiros</span>
		<ul class="links">
			<li><a href="https://github.com/ramonmedeiros" target="_blank" rel="noopener">GitHub</a></li>
			<li>
				<a href="https://www.linkedin.com/in/ramonmedeiros/" target="_blank" rel="noopener"
					>LinkedIn</a
				>
			</li>
			<li><a href="/rss.xml">RSS</a></li>
		</ul>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid var(--border);
		color: var(--muted);
		font-size: 0.875rem;
	}
	.inner {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		align-items: center;
		justify-content: space-between;
		max-width: var(--measure);
		margin: 0 auto;
		padding: 1.5rem 1.25rem 2.5rem;
	}
	.links {
		display: flex;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.links li + li {
		margin-top: 0;
	}
	.links a {
		color: var(--muted);
		text-decoration: none;
	}
	.links a:hover {
		color: var(--heading);
	}
</style>
